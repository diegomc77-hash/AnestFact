{
  "manifest_version": 3,
  "name": "AnesFact GECLISA Batch (pasos 1–12)",
  "version": "0.6.29",
  "description": "GECLISA Mayo + evweb ADAARC (cola + idUsuario sesión).",
  "permissions": ["storage", "tabs", "scripting", "debugger", "clipboardRead", "alarms"],
  "host_permissions": [
    "http://sanatoriomayo.myvnc.com:84/*",
    "https://adaarc.evweb.com.ar/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://diegomc77-hash.github.io/*",
    "https://anestfact.diegomc77.workers.dev/*",
    "https://*.diegomc77.workers.dev/*"
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://diegomc77-hash.github.io/*",
      "https://anestfact.diegomc77.workers.dev/*",
      "https://*.diegomc77.workers.dev/*"
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AnesFact GECLISA Batch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://sanatoriomayo.myvnc.com:84/*"],
      "js": ["lib/human.js", "lib/dom.js", "content/geclisa.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["https://adaarc.evweb.com.ar/*"],
      "js": ["content/evweb.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://diegomc77-hash.github.io/*",
        "https://anestfact.diegomc77.workers.dev/*",
        "https://*.diegomc77.workers.dev/*"
      ],
      "js": ["content/anesfact-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
