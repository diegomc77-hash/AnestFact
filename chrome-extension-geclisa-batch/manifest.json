{
  "manifest_version": 3,
  "name": "AnesFact GECLISA Batch (pasos 1–12)",
  "version": "0.5.2",
  "description": "GECLISA Mayo: runner; recovery tras paso 11 si el CS muere al abrir plantilla; fill en frame #8054.",
  "permissions": ["storage", "tabs", "scripting", "debugger", "clipboardRead"],
  "host_permissions": [
    "http://sanatoriomayo.myvnc.com:84/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://diegomc77-hash.github.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "AnesFact GECLISA Batch",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["http://sanatoriomayo.myvnc.com:84/*"],
      "js": ["lib/human.js", "lib/dom.js", "content/geclisa.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://diegomc77-hash.github.io/*"
      ],
      "js": ["content/anesfact-bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
